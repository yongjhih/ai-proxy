{
  "name": "ai-proxy · MCP Pages Development Environment",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8788],
  "portsAttributes": {
    "8788": {
      "label": "ai-proxy Local Relay",
      "onAutoForward": "notify"
    }
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
  "containerEnv": {
    "AI_PROXY_HOST": "host.docker.internal",
    "AI_PROXY_PORT": "8788",
    "AI_PROXY_URL": "http://host.docker.internal:8788",
    "AI_PROXY_HOME": "/home/node/.config/ai-proxy"
  },
  "mounts": [
    "source=${localEnv:HOME}/.config/ai-proxy,target=/home/node/.config/ai-proxy,type=bind,consistency=cached"
  ],
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  }
}
