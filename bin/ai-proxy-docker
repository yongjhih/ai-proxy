#!/usr/bin/env sh
# Docker wrapper CLI for ai-proxy.
# Uses Node.js CLI wrapper when node is available; falls back to pure POSIX sh + docker otherwise.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if command -v node >/dev/null 2>&1 && [ -f "${SCRIPT_DIR}/ai-proxy-docker.mjs" ]; then
  exec node "${SCRIPT_DIR}/ai-proxy-docker.mjs" "$@"
fi

DOCKER_BIN="${AI_PROXY_DOCKER_BIN:-docker}"
IMAGE_NAME="${AI_PROXY_DOCKER_IMAGE:-ai-proxy:local}"
PORT="${AI_PROXY_PORT:-8788}"
CONFIG_DIR="${AI_PROXY_HOME:-$HOME/.config/ai-proxy}"
REPO_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)"

mkdir -p "$CONFIG_DIR"

if [ "${1:-}" = "run" ]; then
  shift
  exec "$DOCKER_BIN" run \
    --add-host=host.docker.internal:host-gateway \
    -e "AI_PROXY_HOST=host.docker.internal" \
    -e "AI_PROXY_PORT=${PORT}" \
    -e "AI_PROXY_URL=http://host.docker.internal:${PORT}" \
    -v "${CONFIG_DIR}:/root/.config/ai-proxy" \
    "$@"
fi

if ! "$DOCKER_BIN" image inspect "$IMAGE_NAME" >/dev/null 2>&1; then
  "$DOCKER_BIN" build -t "$IMAGE_NAME" "$REPO_ROOT" >&2
fi

SUBCMD="${1:-serve}"
if [ "$SUBCMD" = "serve" ]; then
  exec "$DOCKER_BIN" run --rm -i \
    --add-host=host.docker.internal:host-gateway \
    -e "AI_PROXY_HOME=/data/ai-proxy" \
    -p "127.0.0.1:${PORT}:8788" \
    -v "${CONFIG_DIR}:/data/ai-proxy" \
    -v "$(pwd):/workspace" \
    -w /workspace \
    "$IMAGE_NAME" "$@" --host 0.0.0.0 --port 8788
else
  exec "$DOCKER_BIN" run --rm -i \
    --add-host=host.docker.internal:host-gateway \
    -e "AI_PROXY_HOME=/data/ai-proxy" \
    -v "${CONFIG_DIR}:/data/ai-proxy" \
    -v "$(pwd):/workspace" \
    -w /workspace \
    "$IMAGE_NAME" "$@"
fi
